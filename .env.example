# Telegram Bot Token (احصل عليه من @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gemini API Key (احصل عليه من Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# اسم شيت الإكسيل على Google Sheets
SPREADSHEET_NAME=Your_Wallet

# منفذ خادم الويب (اختياري - للاستجابة على منصات الاستضافة مثل Render)
PORT=8080
